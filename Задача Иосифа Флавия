def josephus(k, n):
    m = list(range(1, 1 + n))  # Создаем список от 1 до n
    ans = []                   # Список для хранения порядка выхода
    i = 0                      # Начальный индекс
    
    while m:                   # Продолжаем, пока список не пустой
        i = (i + k - 1) % len(m)  # Считываем позицию следующего участника
        ans.append(m.pop(i))      # Добавляем его в ответ и удаляем из списка
    
    return ans                 # Возвращаем порядок выхода

n = 5                          # Количество участников
k = 2                          # Шаг для выбора участника

print(josephus(k, n)) 
